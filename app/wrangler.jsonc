{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homestand",
  // No "account_id" key here: wrangler rejects it outright for Pages projects
  // ("Configuration file for Pages projects does not support account_id"), which
  // breaks every `wrangler pages` command. The account comes from
  // CLOUDFLARE_ACCOUNT_ID in CI and from local OAuth auth in dev instead.
  // Without an explicit account, --remote calls fail with API error 7403
  // ("given account is not valid or is not authorized").
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_NAME": "Homestand",
  },
  // TURNSTILE_SECRET_KEY, ADMIN_API_KEY and CREDENTIALS_ENCRYPTION_KEY are
  // secrets, not vars -- declaring them here as empty strings invites someone
  // to fill one in and commit it. They ship with `wrangler secret put <NAME>`
  // and live in .env locally. The handlers all fail closed when unset.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homestand-db",
      "database_id": "689406df-4953-48b1-8b36-66c871a64fab",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "RAW_ARCHIVE",
      "bucket_name": "homestand-raw-archive",
    },
  ],
}
