{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.functions.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    /* No "types": ["node"] and no @cloudflare/workers-types entry. The runtime
       globals (D1Database, R2Bucket, ExecutionContext, PagesFunction, ...) and
       the `Env` interface built from wrangler.jsonc's bindings all come from
       worker-configuration.d.ts, which `wrangler types` generates. Pulling in
       @cloudflare/workers-types as well redeclares the same globals and
       produces duplicate-identifier errors. */
    "types": [],
    "skipLibCheck": true,

    /* Bundler mode. Wrangler bundles Pages Functions with esbuild and resolves
       extensionless relative imports, which "nodenext" rejects -- every handler
       imports "../../lib/auth" without an extension. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    /* Linting -- kept identical to tsconfig.app.json / tsconfig.node.json so all
       three projects enforce the same rules. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* functions/ is the Pages Functions tree. lib/ is shared with the browser
     tests in src/lib/*.test.ts (collections, espnSession, espn/espnClient), so
     it is listed here too -- it is environment-agnostic and has no imports. */
  "include": ["functions", "lib", "worker-configuration.d.ts"]
}
