{
  "name": "homestand",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-data.mjs",
    "dev": "npm run dev:vite & wrangler pages dev --proxy 5173",
    "dev:vite": "vite --strictPort --port 5173",
    "build": "node scripts/sync-data.mjs && node scripts/upload-r2.mjs && tsc -b && vite build && node scripts/strip-public-data.mjs",
    "upload-r2:remote": "node scripts/upload-r2.mjs --remote",
    "deploy": "npm run build && npm run upload-r2:remote && wrangler pages deploy dist",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "pretest": "node scripts/sync-data.mjs",
    "test": "vitest run",
    "crawl": "node ../scripts/run_import.mjs",
    "clean": "rm -rf node_modules/.vite node_modules/.tmp dist"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "@workermailer/smtp": "^0.2.1",
    "geist": "^1.7.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.147.0"
  }
}
