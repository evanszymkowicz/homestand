# Processed league data is NOT a static asset. It is served only through the
# authenticated proxy at /api/data/{importId}/{collection}, which checks the
# session, the import's owner, its status, and its retention expiry before
# reading the R2 object. Caching therefore keys off the caller's cookie, not a
# shared CDN cache — do not add a public Cache-Control rule for /data/*.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
